# =============================================================================
# SAPU — .gitignore
# =============================================================================

# -----------------------------------------------------------------------------
# Secrets
# -----------------------------------------------------------------------------
# .env holds deployer private keys. Never commit it.
# .env.example is the committed template.
.env
.env.*
!.env.example
.env.local
.env.*.local

# Foundry's own env file
contracts/.env


# -----------------------------------------------------------------------------
# Node / Next.js
# -----------------------------------------------------------------------------
node_modules/
.pnp
.pnp.*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Next.js build output
.next/
out/
next-env.d.ts
*.tsbuildinfo

# Vercel
.vercel


# -----------------------------------------------------------------------------
# Foundry build artefacts
# -----------------------------------------------------------------------------
# out/ and cache/ are regenerated by `forge build`. broadcast/ holds the
# deployment records — those are useful evidence for a hackathon submission, but
# they are regenerated per-run and can be large. Kept out of git; the README
# records the deployed addresses instead.
contracts/out/
contracts/cache/
contracts/broadcast/
contracts/deployments/local-*.json
contracts/lcov.info

# Foundry dependency checkpoints
contracts/foundry.lock


# -----------------------------------------------------------------------------
# Solidity dependencies
# -----------------------------------------------------------------------------
# Reinstalled with `forge install` (see README "Contracts" section for the pinned
# revisions). Committing vendored OZ + forge-std adds ~12 MB of third-party code
# to the repo with no benefit: the remappings in foundry.toml are version-pinned.
contracts/lib/


# -----------------------------------------------------------------------------
# Test + coverage output
# -----------------------------------------------------------------------------
coverage/
*.lcov
lcov.info
.vitest/
test-results/
playwright-report/


# -----------------------------------------------------------------------------
# Editor / OS
# -----------------------------------------------------------------------------
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini


# -----------------------------------------------------------------------------
# Logs and scratch files
# -----------------------------------------------------------------------------
*.log
logs/
.sapu-e2e-*/
