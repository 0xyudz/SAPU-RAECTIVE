{
  "name": "sapu",
  "version": "1.0.0",
  "private": true,
  "description": "SAPU — Silent Automated Purge Unit. Fund a burner wallet. It empties itself before anyone can watch it fill.",
  "license": "MIT",
  "workspaces": [
    "app"
  ],
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "npm run dev --workspace app",
    "build": "npm run audit && npm run build --workspace app",
    "start": "npm run start --workspace app",
    "lint": "npm run lint --workspace app",
    "typecheck": "npm run typecheck --workspace app",
    "typecheck:scripts": "tsc --noEmit -p scripts/tsconfig.json",
    "audit": "tsx scripts/audit-surface.ts",
    "test:app": "npm run test --workspace app",
    "test:contracts": "forge test --root contracts",
    "coverage:contracts": "forge coverage --root contracts --no-match-coverage \"test/*|script/*\" --report summary",
    "build:contracts": "forge build --root contracts",
    "e2e": "bash scripts/e2e-demo.sh",
    "e2e:views": "node scripts/e2e-views.mjs",
    "trigger-deposit": "tsx scripts/trigger-deposit.ts",
    "verify-sweep": "tsx scripts/verify-sweep.ts",
    "verify-proof": "tsx scripts/verify-proof.ts",
    "prove:rescue": "tsx --tsconfig app/tsconfig.json scripts/prove-rescue.mts",
    "prove:dust": "tsx --tsconfig app/tsconfig.json scripts/prove-dust-floor.mts",
    "prove:multi-token": "tsx --tsconfig app/tsconfig.json scripts/prove-multi-token.mts",
    "test": "npm run test:contracts && npm run test:app"
  },
  "devDependencies": {
    "playwright-core": "^1.65.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "viem": "^2.57.20"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
