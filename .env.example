# =============================================================================
# SAPU — environment template
# =============================================================================
#
# Copy to .env and fill in. Nothing here is required to *build* or *test*:
#   npm install && npm run test && npm run build
# all succeed with an empty environment. Only the live 3-transaction loop needs
# real keys and deployed addresses.
#
#   cp .env.example .env
#
# Order of operations (see README.md for the full walkthrough):
#   1. Deploy SapuRSC on the Reactive chain       → SAPU_RSC_ADDRESS
#   2. Deploy SapuForwarder on the origin chain   → SAPU_FORWARDER_ADDRESS, SAPU_TOKEN_ADDRESS
#   3. Arm the route on both sides                → needs SAPU_BURNER_ADDRESS, SAPU_COLD_WALLET
#   4. bash scripts/e2e-demo.sh
#
# Step 2 is chain-agnostic: `DeployDestination` reads the callback proxy for the
# chain its RPC points at from contracts/script/ReactiveChains.sol and refuses an
# unlisted chain. Point it at another Reactive origin and it deploys there.
#
# NEVER commit .env. It is gitignored.
# =============================================================================


# -----------------------------------------------------------------------------
# Which network, and which origin chain
# -----------------------------------------------------------------------------
# SAPU runs on Reactive mainnet or on a Reactive testnet. These variables pick
# the pair. Note the two prefixes: `SAPU_ORIGIN_CHAIN_ID` is read by the deploy
# script, `NEXT_PUBLIC_SAPU_NETWORK` / `NEXT_PUBLIC_SAPU_ORIGIN_CHAIN_ID` are
# read by the app (they are inlined into the browser bundle, so they must carry
# the NEXT_PUBLIC_ prefix). scripts/deploy-live.sh writes the NEXT_PUBLIC_ pair
# into app/.env.local for you.
#
# The full set of chains comes from the official table at
# https://dev.reactive.network/origins-and-destinations — 9 mainnet and 4
# testnet chains. The table lives in contracts/script/ReactiveChains.sol (for
# deploy) and app/src/config/chains.ts (for the app), both pinned by tests.
#
# Mainnet and testnet are never mixed: a callback cannot cross that boundary,
# so a mismatched pair is refused at deploy time and reported as a configuration
# error in the app rather than silently falling back to a default pair.

# The chain whose ERC-20 deposits are watched, and where SapuForwarder runs.
# Must be an origin/destination chain on the same network as the Reactive chain.
#
#   testnet  1301 Unichain Sepolia · 84532 Base Sepolia ·
#            11155111 Ethereum Sepolia
#   mainnet  1 Ethereum · 56 BSC · 130 Unichain · 999 HyperEVM ·
#            4663 Robinhood · 8453 Base · 42161 Arbitrum · 43114 Avalanche
#
# Reactive chains themselves (1597, 5318007) cannot be origins: SAPU watches
# token transfers on a token chain. DeployReactiveOmni refuses both that and a
# mainnet/testnet mismatch.
SAPU_ORIGIN_CHAIN_ID=84532


# -----------------------------------------------------------------------------
# RPC endpoints
# -----------------------------------------------------------------------------
# Two are required for the live loop. Public endpoints are fine for a demo; use
# a dedicated provider if you are rate-limited.
#
# Reactive publishes endpoints for its own chains. For every other origin and
# destination the official table links to Chainlist and expects the operator to
# supply one, so SAPU does not invent defaults — a made-up endpoint fails at the
# first request. The app reports "RPC not configured" for a chain with no
# endpoint instead of guessing.

# The origin chain (whatever SAPU_ORIGIN_CHAIN_ID names). The name below is
# historical: the deploy scripts still read BASE_SEPOLIA_RPC_URL, so it holds the
# origin endpoint regardless of which chain that is.
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# The Reactive chain where SapuRSC runs (1597 mainnet, 5318007 Lasna).
REACTIVE_RPC_URL=https://lasna-rpc.rnk.dev/


# -----------------------------------------------------------------------------
# Deployer keys
# -----------------------------------------------------------------------------
# Two different keys, because the two halves live on two chains.
#
# DEPLOYER_PRIVATE_KEY  — origin chain. Deploys SapuForwarder, sends the deposit,
#                         pays callback gas through the callback proxy.
# REACTIVE_PRIVATE_KEY  — Reactive chain. Deploys SapuRSC, arms routes, pays for
#                         reactive transactions in the chain's native token.
#
# Neither key is ever the burner. The burner is generated in the browser and its
# key never leaves the tab.
#
# FUNDING:
#   Base Sepolia ETH  → https://www.alchemy.com/faucets/base-sepolia
#   lREACT            → send Base Sepolia ETH to the faucet at
#                       0x2afaFD298b23b62760711756088F75B7409f5967 (1 ETH → 100 lREACT)
#                       Max 5 ETH per transaction. Excess is lost.
#
# Use throwaway keys. These are hot wallets in a hackathon demo.

DEPLOYER_PRIVATE_KEY=
REACTIVE_PRIVATE_KEY=


# -----------------------------------------------------------------------------
# Ownership
# -----------------------------------------------------------------------------
# Operator allowed to arm/revoke routes, set the forwarder, pause, and change the
# callback gas limit. Leave this commented out so it defaults to the broadcasting
# address. If you set it, it must be the address of the key that signs the
# owner-only transactions (REACTIVE_PRIVATE_KEY for SapuRSC).

# SAPU_OWNER=


# -----------------------------------------------------------------------------
# Deployed contract addresses
# -----------------------------------------------------------------------------
# Filled in as you complete each deployment step. Empty until then.

# Step 1 — SapuRSC on the Reactive chain (1597 or 5318007).
SAPU_RSC_ADDRESS=

# Step 2 — SapuForwarder on the origin chain named by SAPU_ORIGIN_CHAIN_ID.
SAPU_FORWARDER_ADDRESS=

# The ERC-20 being swept. Leave unset during DeployDestination to deploy a fresh
# SweepableERC20 (18 decimals, symbol SAPU); set it to reuse an existing token.
SAPU_TOKEN_ADDRESS=


# -----------------------------------------------------------------------------
# The route
# -----------------------------------------------------------------------------
# A route is (token, burner) → coldWallet. Both sides must be armed; see
# contracts/script/RegisterBurner.s.sol.

# The burner to watch. Generate one in the app at /app and paste the address.
# It needs no ETH and never signs anything.
SAPU_BURNER_ADDRESS=

# Where swept funds land. A cold wallet you control.
SAPU_COLD_WALLET=

# Only needed to resume an existing burner whose allowance is still zero. On a
# fresh run arm-route.ts generates a burner and keeps its key in memory.
SAPU_BURNER_PRIVATE_KEY=


# -----------------------------------------------------------------------------
# Demo tuning (optional)
# -----------------------------------------------------------------------------

# Token amount sent by scripts/trigger-deposit.ts and scripts/e2e-demo.sh.
SAPU_DEPOSIT_AMOUNT=1

# Block to start scanning from in scripts/verify-sweep.ts. Leave unset to scan
# from the current head (faster) or pass --from-block explicitly.
SAPU_FROM_BLOCK=

# Explorer base URLs for the scripts' links. Optional: scripts/lib/explorers.ts
# already covers every chain in the official table. Set these only for a private
# explorer, or for a chain added after that file was written. An unknown chain
# omits the link rather than pointing at another chain's explorer.
# SAPU_ORIGIN_EXPLORER_URL=
# SAPU_REACTIVE_EXPLORER_URL=

# Native value sent to SapuRSC on the Reactive chain at deploy time. It pays for
# subscriptions and reactions, so keep it funded (0.05 is a demo minimum).
SAPU_RSC_FUND_VALUE=0.05ether


# -----------------------------------------------------------------------------
# Web app (Next.js)
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_* values are inlined into the client bundle at build time. They are
# public by definition — addresses and RPC URLs only, never keys.
#
# The app degrades honestly when these are unset: /api/watch returns 503, the
# proof table shows "waiting" rather than a placeholder hash, and the watcher
# renders "—" for block heights instead of a fabricated number.

# Which Reactive network the app should read. "testnet" is the default; set to
# "mainnet" to run against Reactive mainnet. Pair it with the matching
# NEXT_PUBLIC_SAPU_ORIGIN_CHAIN_ID — a mismatch is reported in the UI as a
# configuration error, never silently corrected.
NEXT_PUBLIC_SAPU_NETWORK=testnet

# The origin chain the app reads and writes. Must be a Reactive origin on the
# same network as NEXT_PUBLIC_SAPU_NETWORK. See app/src/config/chains.ts for the
# full table, or https://dev.reactive.network/origins-and-destinations.
NEXT_PUBLIC_SAPU_ORIGIN_CHAIN_ID=84532

# RPC endpoints used by the browser. One per chain, named by chain id. The two
# historical names below are still honoured and take priority:
#   NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL  → chain 84532
#   NEXT_PUBLIC_REACTIVE_RPC_URL      → chain 5318007
# Any other chain needs its own NEXT_PUBLIC_RPC_URL_<id>. They must be written
# literally (Next.js only inlines statically visible accesses), so add the line
# to app/src/config/chain-rpc.ts as well as here. A chain with no endpoint
# reports "RPC not configured" rather than borrowing another chain's URL.
NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
NEXT_PUBLIC_REACTIVE_RPC_URL=https://lasna-rpc.rnk.dev/
# NEXT_PUBLIC_RPC_URL_1=
# NEXT_PUBLIC_RPC_URL_56=
# NEXT_PUBLIC_RPC_URL_130=
# NEXT_PUBLIC_RPC_URL_999=
# NEXT_PUBLIC_RPC_URL_1597=
# NEXT_PUBLIC_RPC_URL_4663=
# NEXT_PUBLIC_RPC_URL_8453=
# NEXT_PUBLIC_RPC_URL_42161=
# NEXT_PUBLIC_RPC_URL_43114=
# NEXT_PUBLIC_RPC_URL_1301=
# NEXT_PUBLIC_RPC_URL_11155111=

# Deployment addresses surfaced in the UI. Same values as SAPU_* above, but these
# are the ones the client bundle actually reads.
NEXT_PUBLIC_SAPU_RSC_ADDRESS=
NEXT_PUBLIC_SAPU_FORWARDER_ADDRESS=
NEXT_PUBLIC_SAPU_TOKEN_ADDRESS=

# Display metadata for the swept token.
NEXT_PUBLIC_SAPU_TOKEN_SYMBOL=SAPU
NEXT_PUBLIC_SAPU_TOKEN_DECIMALS=18

# Optional override for the callback proxy. Leave unset: the proxy is looked up
# from the origin chain in app/src/config/chains.ts, which is the source of truth
# and is pinned to the official table by tests. Set this only when a proxy has
# been redeployed at a different address.
# NEXT_PUBLIC_SAPU_CALLBACK_PROXY=

# Deploy block for event indexing. scripts/deploy-live.sh writes these into
# app/.env.local automatically; set them by hand only for a manual deployment.
NEXT_PUBLIC_SAPU_RSC_DEPLOY_BLOCK=
NEXT_PUBLIC_SAPU_FORWARDER_DEPLOY_BLOCK=

# NOTE: app/.env.local is generated by scripts/deploy-live.sh and contains only
# NEXT_PUBLIC_* values. Do not put private keys there; Next.js inlines those
# values into the browser bundle. Keys belong in this root .env only.
