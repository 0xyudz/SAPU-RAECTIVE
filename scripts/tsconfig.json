{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noUncheckedIndexedAccess": true,
    "types": ["node"],
    "baseUrl": "..",
    "paths": {
      "@/*": ["./app/src/*"]
    }
  },
  "include": [
    "prove-rescue.mts",
    "prove-dust-floor.mts",
    "lib/app-writer.mts",
    "lib/env.mts",
    "lib/rpc.ts"
  ]
}
